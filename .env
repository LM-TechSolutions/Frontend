# Frontend talks to the backend through the Vite dev proxy (same-origin), so the
# API/socket base URLs are relative. The proxy targets http://localhost:3000
# (configured in vite.config.ts).
VITE_API_BASE_URL=http://localhost:3003
VITE_SOCKET_URL=http://localhost:3003

# Gebeta Maps token (copied from Backend/.env GEBETA_MAPS_API_KEY). Has TILE +
# DIRECTION + GEOCODING scopes, so it powers both the map tiles and search/routing.
VITE_GEBETA_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..RnR5UjYBhv9LrBMOfRa4WknvfRMedPOrQlHc3DsdstE
