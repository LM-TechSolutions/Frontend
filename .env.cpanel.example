# ==============================================================================
# Frontend cPanel Deployment Environment Configuration
# ==============================================================================
# In Vite, variables prefixed with VITE_ are injected into the build bundle
# during `vite build`.
#
# Add these to GitHub Repository Secrets:
#   - VITE_API_BASE_URL: https://backend-api.tokuma.et
#   - VITE_SOCKET_URL:   https://backend-api.tokuma.et
#   - VITE_GEBETA_API_KEY: your-gebeta-maps-token
# ==============================================================================

VITE_API_BASE_URL=https://backend-api.tokuma.et
VITE_SOCKET_URL=https://backend-api.tokuma.et
VITE_GEBETA_API_KEY=your-gebeta-maps-api-key
