# Copy to .env / Vercel Environment.
# Local (`npm run dev`): http://localhost:3003 (see .env.development).
# Production (Vercel): public Render origin, no trailing slash.
VITE_API_BASE_URL=https://backend-74ah.onrender.com
VITE_SOCKET_URL=https://backend-74ah.onrender.com

# Gebeta Maps token — copy the value of GEBETA_MAPS_API_KEY from Backend/.env.
# It needs the TILE scope (map display) plus DIRECTION/GEOCODING (search & routing).
VITE_GEBETA_API_KEY=your-gebeta-maps-token
