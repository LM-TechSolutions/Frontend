# ==============================================================================
# Frontend Environment Variables Template
# ==============================================================================
# In production / CI (GitHub Actions / Vercel), set these in your Repository Secrets
# or environment settings.
# ==============================================================================

# Backend API & WebSocket Endpoint (No trailing slash)
VITE_API_BASE_URL=https://backend-api.tokuma.et
VITE_SOCKET_URL=https://backend-api.tokuma.et

# Gebeta Maps Token (Needs TILE, DIRECTION, GEOCODING scopes)
VITE_GEBETA_API_KEY=your-gebeta-maps-api-key
