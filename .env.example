# Copy to .env.
# Local: leave these empty so the Vite proxy (vite.config.ts) keeps API +
# cookies same-origin. Production (Vercel): set BOTH to the public HTTPS
# backend origin, with no trailing slash — e.g. https://api.yourdomain.com
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Gebeta Maps token — copy the value of GEBETA_MAPS_API_KEY from Backend/.env.
# It needs the TILE scope (map display) plus DIRECTION/GEOCODING (search & routing).
VITE_GEBETA_API_KEY=your-gebeta-maps-token
